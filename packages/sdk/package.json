{
  "name": "@vivekumar08/query-analyser",
  "version": "0.1.0",
  "description": "Find your slow MongoDB queries. One line of setup.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "keywords": ["mongodb", "mongoose", "slow-query", "performance", "apm", "profiler"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {},
  "peerDependencies": { "mongoose": ">=8 <9" },
  "devDependencies": {
    "@query-analyser/contract": "workspace:*",
    "@types/node": "^22.0.0",
    "mongoose": "^8.9.0",
    "mongodb-memory-server": "^10.1.2",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

{
  "name": "@vivekumar08/query-analyser",
  "version": "0.3.0",
  "description": "Find your slow MongoDB queries. One line of setup.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "keywords": ["mongodb", "mongoose", "slow-query", "performance", "apm", "profiler"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build && pnpm typecheck && pnpm test"
  },
  "dependencies": {},
  "peerDependencies": { "mongoose": ">=5.13 <10", "mongodb": ">=4 <8", "pg": ">=8.0 <9", "@prisma/client": ">=5.22 <8" },
  "peerDependenciesMeta": {
    "mongoose": { "optional": true },
    "mongodb": { "optional": true },
    "pg": { "optional": true },
    "@prisma/client": { "optional": true }
  },
  "devDependencies": {
    "@query-analyser/contract": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "mongodb": "^6.20.0",
    "mongodb-memory-server": "^10.1.2",
    "mongoose": "^8.9.0",
    "pg": "^8.23.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

# Absolute origin of the API, no trailing slash. Read per request (never at
# build time). Server-to-server only: the browser never calls it directly.
API_ORIGIN=http://localhost:8080
# Public origin of THIS web app, exactly as the browser sees it (scheme + host
# [+ port]), e.g. https://app.example.com. The auth POST handlers reject any
# request whose Origin header differs (CSRF guard, Ruling B19). When unset
# (local dev only) they fall back to comparing the Origin's host with the Host
# header. Set it in every deployed environment.
WEB_ORIGIN=

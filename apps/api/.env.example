DATABASE_URL=postgresql://qa:qa@localhost:5432/qa
JWT_SECRET=change-me-32-bytes-minimum-please-really
COOKIE_SECRET=change-me-32-bytes-minimum-please-really
PORT=8080
LOG_LEVEL=info
# Set to 'true' (or a comma-separated CIDR/IP list) only when this service sits
# behind a trusted reverse proxy; otherwise clients can forge X-Forwarded-For.
TRUST_PROXY=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Vigor Tempo
WEB_ORIGIN=
# Optional, >=32 chars. Shared secret with the web app (same value as the web
# service's WEB_PROXY_SECRET). When set, auth rate limits key on the browser IP
# the web app forwards in x-qa-client-ip, but only on requests presenting this
# secret in x-qa-proxy-secret. Unset: every limit keys on the caller's IP, so
# all browser logins share the web server's single bucket.
WEB_PROXY_SECRET=
# Optional UTC date (YYYY-MM-DD), default 2027-01-31. Until then every org keeps
# at least 90 days of daily data whatever its plan; after it, each plan's own
# retention applies (free 30, pro 90, team 365). Hourly data is always 7 days.
RETENTION_GRACE_UNTIL=
